# Contact form — Formspree (https://formspree.io)
# Already wired to a working default directly in ContactForm.tsx, so this is
# optional — only set it here if you want to point at a *different* form
# (e.g. a separate one for a staging environment) without editing code.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Newsletter signup — Resend (https://resend.com)
# Only needed if you're keeping the newsletter signup in the footer working.
# Note: src/app/api/contact/route.ts is currently unused dead code — the
# contact form itself was switched to Formspree above. This Resend setup
# only powers the separate newsletter signup in the footer.
RESEND_API_KEY=your-resend-api-key
CONTACT_NOTIFY_EMAIL=hello@grandisinovo.com

NEXT_PUBLIC_SITE_URL=https://grandisinnovo.com
